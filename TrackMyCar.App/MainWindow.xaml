<Window
    x:Class="TrackMyCar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:TrackMyCar.App.Views"
    Title="{Binding ApplicationTitle}"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border Grid.Column="0" Background="#1E293B">
            <StackPanel>
                <TextBlock
                    Margin="24,28,24,32"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="TrackMyCar" />

                <Button
                    Height="48"
                    Margin="12,0,12,8"
                    Padding="16,0"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowDashboardCommand}"
                    Content="Dashboard"
                    FontSize="15" />

                <Button
                    Height="48"
                    Margin="12,0,12,8"
                    Padding="16,0"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowCarsCommand}"
                    Content="Cars"
                    FontSize="15" />

                <Button Content="Fuel"
                    Command="{Binding ShowFuelCommand}"
                    Height="48"
                    Margin="12,0,12,8"
                    HorizontalContentAlignment="Left"
                    Padding="16,0"
                    FontSize="15"/>

                <Button Content="Services"
                    Command="{Binding ShowServicesCommand}"
                    Height="48"
                    Margin="12,0,12,8"
                    HorizontalContentAlignment="Left"
                    Padding="16,0"
                    FontSize="15"/>

                <Button Content="Statistics"
                    Command="{Binding ShowStatisticsCommand}"
                    Height="48"
                    Margin="12,0,12,8"
                    HorizontalContentAlignment="Left"
                    Padding="16,0"
                    FontSize="15"/>

                <Button Content="Settings"
                    Command="{Binding ShowSettingsCommand}"
                    Height="48"
                    Margin="12,0,12,8"
                    HorizontalContentAlignment="Left"
                    Padding="16,0"
                    FontSize="15"/>
                    
            </StackPanel>
        </Border>

        <!--  Main content  -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
