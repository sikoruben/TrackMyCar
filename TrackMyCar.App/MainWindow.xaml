<Window x:Class="TrackMyCar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrackMyCar.App.Views"
        Title="{Binding ApplicationTitle}"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1E293B">
            <StackPanel>
                <TextBlock Text="TrackMyCar"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="24,28,24,32"/>

                <Button Content="Dashboard"
                        Height="48"
                        Margin="12,0,12,8"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        FontSize="15"/>

                <Button Content="Cars"
                        Height="48"
                        Margin="12,0,12,8"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        FontSize="15"/>

                <Button Content="Fuel"
                        Height="48"
                        Margin="12,0,12,8"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        FontSize="15"/>

                <Button Content="Services"
                        Height="48"
                        Margin="12,0,12,8"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        FontSize="15"/>

                <Button Content="Statistics"
                        Height="48"
                        Margin="12,0,12,8"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        FontSize="15"/>

                <Button Content="Settings"
                        Height="48"
                        Margin="12,0,12,8"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        FontSize="15"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <views:DashboardView Grid.Column="1"/>
    </Grid>
</Window>