<Application x:Class="TrackMyCar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TrackMyCar.App.ViewModels"
             xmlns:views="clr-namespace:TrackMyCar.App.Views"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CarsViewModel}">
            <views:CarsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:FuelViewModel}">
            <views:FuelView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ServicesViewModel}">
            <views:ServicesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

    </Application.Resources>
</Application>